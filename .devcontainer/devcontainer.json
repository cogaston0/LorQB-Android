{
  "name": "LorQB-Android Unity Dev",
  "image": "mcr.microsoft.com/devcontainers/dotnet:8.0",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/devcontainers/features/android-sdk:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-vscode.mono-debug",
        "unity.unity-debug",
        "tobiah.unity-tools",
        "kleber-swf.unity-code-snippets"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "files.encoding": "utf8",
        "dotnet.defaultSolution": "disable"
      }
    }
  },
  "postCreateCommand": "echo '✅ LorQB-Android Codespace ready. Edit C# scripts here. Use GitHub Actions to build the APK.'",
  "remoteUser": "vscode"
}
